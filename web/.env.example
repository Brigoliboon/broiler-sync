# BroilerSync web env var names. Copy to .env.local and fill in. Never commit real values.

# Supabase (server-only names preferred; NEXT_PUBLIC_* still work as fallbacks)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key, server-only. Never expose to the browser or firmware.
SUPABASE_SECRET=

# Web push (FR-23). Generate once with: npx web-push generate-vapid-keys
# The public key is sent to the browser; the private key stays on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
